FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      N2.multicomponent;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.5;

boundaryField
{
    fuel
    {
        type            calculated;
        value           uniform 0.5;
    }
    air
    {
        type            calculated;
        value           uniform 0.5;
    }
    outlet
    {
        type            calculated;
        value           uniform 0.5;
    }
    frontAndBack
    {
        type            empty;
    }
}


