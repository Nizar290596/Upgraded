FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           dictionary;
    object          sprayProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solution
{
    //- FV fields to particle interpolation
    interpolationSchemes
    {
        U           cellPoint;
        DEff        cellPoint;
        rho         cellPoint;
        gradRho     cellPoint;
        gradRhoDEff cellPoint;
        f           cellPoint;
        p           cellPoint;
    }
}

particleManagement
{
    //- Particle number control
    numCtlOn         on;

    Npc 10;
    Nlo 8;
    Nhi 14;
}

subModels
{
    InflowBoundaryModel          FreeStream;
    //InflowBoundaryModel          NoInflow;

    compositionModel singlePhaseMixture;
    // compositionModel none;

    sootModel                   none;

    radiationModel OpticallyThinRadiation;
    OpticallyThinRadiationCoeffs
    {
        TRef     300;
    }
    // radiationModel none;

    printMoleFractions false;
    
    thermoPhysicalCouplingModel FlameletCurves;
    //thermoPhysicalCouplingModel KernelEstimation;
    //
    // NOTE: this case runs the mixing-model test harness (application test.exe),
    // not SPFoam, so the coupling block below is NOT exercised at run time — it is
    // a reference configuration. Copy it into an SPFoam case to use it.

    KernelEstimationCoeffs
    {
        // --- k-NN kernel controls (apply in either conditioning mode) ---
        nNearest            20;     // flagged particles per cell kernel (default 20)
        rMax                1e9;    // physical kernel-radius cap [m] (1e9 = uncapped)
        dfMax               0.0;    // 0 -> always recompute (no extrapolation reuse; safest)
        C2                  0.1;    // extrapolation resolution control
        debug               false;

        // --- Conditioning band, in the units of condVariable
        //     (condVariable is set in the thermophysicalCoupling dict below) ---

        // (a) condVariable z  (mixture fraction) - no second conditioning needed:
        fLow                0.03;   // lower flammability limit
        fHigh               0.19;   // upper flammability limit
        fm                  0.01;   // conditioning-space bandwidth (acceptance window = +/-0.5*fm)

        // (b) phi-degree conditioning - keep condVariable a coupling variable
        //     (z) and add  conditionOnPhiModified true;  here (do NOT set
        //     condVariable phiModified - it is also used by the chemistry and
        //     would throw "phiModified not found in table"). REQUIRES a
        //     secondConditioning block: phi-degree has no Eulerian field and is
        //     projected from the flagged subset. phi-degree = phi*exp(beta*omegaOU)
        //     ~ [0, ~1.6], so use a phi-degree band and a WIDER bandwidth to span
        //     the OU fluctuation (~ beta*sigma_omega). E.g. with beta = 0.15:
        //         conditionOnPhiModified true;  fLow 0.0;  fHigh 2.0;  fm 0.3;
        //     fLow 0 also drops the no-flagged-particle sentinel (-1). Watch the
        //     "KernelEstimation coupling: X/Y cells covered" line to tune fm.
    }

    mixingModel	    MMCcurl;
    //mixingModel none;
 
    MMCcurlCoeffs
    {
        //- Parameters ri and fm as per Eq.(29) Cleary & Klimenko, Phys Fluids 23, 115102, 2011
        ri                  6.7e-3;

        Ximi
        {
            fm              0.03;    
        }

        localnessLimited    false;

        fLowMixOnMaster     0.01;
        fHighMixOnMaster    1;

        fullSort            false;
        aISO                true; 
        meanTimeScale       false; //true:mean false:max
        pairingMethod       global;
    }
    

    // REQUIRED FOR MIXING MODEL TEST
    dummyMixModelCoeffs
    {
        //- Parameters ri and fm as per Eq.(29) Cleary & Klimenko, Phys Fluids 23, 115102, 2011
        ri                  6.7e-3;

        Ximi
        {
            fm              0.03;    
        }

        localnessLimited    false;

        fLowMixOnMaster     0.01;
        fHighMixOnMaster    1;

        fullSort            false;
        aISO                true; 
        meanTimeScale       false; //true:mean false:max
        pairingMethod       global;
    }

    reactionModel finiteRateParticleChemistry;

    finiteRateParticleChemistryCoeffs
    {
        zLower              0.1;
        zUpper              0.9;
    }
}

//- ThermophysicalModel coupling
thermophysicalCoupling
{
    enabled             true;

    //- List of species for which equivalent
    //  mass fraction solutions are obtained
    //  on the FV grid
    CH4;
    O2;
    CO2;
    H2O;

    condVariable        z;
    
    primarySpecies      CO2;

    tauRelaxBlending    false;
    tauRelaxStart       1000;
    tauRelaxDelta       2;
    tauRelax            10;
    tauUnits            timestep;
}

// Calculate stochastic field statistics on the fly
eulerianStatistics
{
    enabled true;
    axisymmetric false;
    symmetryPlane zx;

    z;
    T;
    CO2;
}

particleSampling
{
    enabled             true;
    
    // defines the thickness of the spanned volume in normal direction
    sampleWidth         0.0005;

    // mixture fraction range of sampled particles
    zLower              0.01;
    zUpper              1.0;

    // only used in parallel mode
    // false:    particle data will be gathered on master node and then be written to ascii data
    // true:    if probe is located within one rank only, gathering will be ommited (which may gives speedup)
    parallelSampling    false;

    numParticlesToStore 1000;

    particleSampleProbes
    {
        zD01
        {
            origin      (0 0 0.00745);
            normal      (0 0 1);
        }

        zD05
        {
            origin      (0 0 0.03725);
            normal      (0 0 1);
        }

        zD10
        {
            origin      (0 0 0.07450);
            normal      (0 0 1);
        }

        zD15
        {
            origin      (0 0 0.11175);
            normal      (0 0 1);
        }
    }
}

