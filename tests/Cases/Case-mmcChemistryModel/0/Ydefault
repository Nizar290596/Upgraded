FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      Ydefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    cyclicTop 
    {
        type            cyclic;
    }

    cyclicBottom 
    {
        type            cyclic;
    }
    
    cyclicFront
    {
        type            cyclic;
    }

    cyclicBack 
    {
        type            cyclic;
    }
    
    cyclicLeft 
    {
        type            cyclic;
    }

    cyclicRight 
    {
        type            cyclic;
    }
}

