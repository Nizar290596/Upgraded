FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ydefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inletFuel
    {
        type            fixedValue;
        value           uniform 0;
    }
    pilot
    {
        type            fixedValue;
        value           uniform 0;
    }
    inletCoflow
    {
	    type zeroGradient;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    
    side
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
}


