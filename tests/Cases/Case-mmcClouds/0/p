FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101300; 

boundaryField
{
    inletFuel
    {
        type            zeroGradient;
    }

    pilot
    {
        type            zeroGradient;
    }

    inletCoflow
    {
        type            zeroGradient;
    }
    
    side
    {
        type            waveTransmissive;
        gamma           1.3;
        fieldInf        101300;
        lInf            0.3;
        value           uniform 101300;
    }

    outlet
    {
        type            waveTransmissive;
        gamma           1.3;
        fieldInf        100000;
        lInf            0.3;
        value           uniform 101300;
    }
}


