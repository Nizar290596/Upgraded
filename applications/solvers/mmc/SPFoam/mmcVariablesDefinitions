FoamFile
{
    version         2.0;
    format          ascii;

    root            "";
    case            "";
    instance        "";
    local           "";

    class           dictionary;
    object          mmcVariablesDefinitions;
}   
    
variables
{ 
    z
    {
        name            z;
        couplingName    z;
        passive         true;
        mixStep         1;
        MMCType         couplingVar;
    }

    // Eulerian phi-degree (modified progress variable) for KernelEstimation
    // conditioning (conditionOnPhiModified). NON-passive: phi-degree has no
    // physical boundary conditions, so XiEqn relaxes this field toward the
    // particle-projected phi-degree (see XiEqn.H) rather than transporting it
    // from BCs like z. Only needed when conditionOnPhiModified is enabled.
    phiModEul
    {
        name            phiModEul;
        couplingName    phiModEul;
        passive         false;
        mixStep         1;
        MMCType         couplingVar;
    }

    sPx
    {
        name            sPx;
        MMCType         referenceVar;
        referenceType   sde;
    }

    sPy
    {
        name            sPy;
        MMCType         referenceVar;
        referenceType   sde;
    }

    sPz
    {
        name            sPz;
        MMCType         referenceVar;
        referenceType   sde;
    }
}
